{
  "name": "@velocity-bpa/n8n-nodes-bitstamp",
  "version": "1.0.0",
  "description": "n8n community node for Bitstamp cryptocurrency trading platform",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://n8n.io",
  "author": {
    "name": "Velocity BPA",
    "email": "support@velocitybpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/velocity-bpa/n8n-nodes-bitstamp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BitstampApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Bitstamp/Bitstamp.node.js"
    ]
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n-node",
    "bitstamp",
    "cryptocurrency",
    "trading",
    "bitcoin",
    "api"
  ],
  "devDependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "crypto": "^1.0.1"
  }
}